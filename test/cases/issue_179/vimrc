execute "source " . expand("<sfile>:p:h:h") . "/vimrc"

if !exists("$VIM_REPEAT_DIR")
    echoerr '$VIM_REPEAT_DIR not set'
    cquit 9
    finish
endif
let &rtp .= "," . $VIM_REPEAT_DIR


noremap ;w w
noremap ;b b
noremap ;e e
noremap ;iw iw
noremap ;aw aw

" Set empty string to every register to test so that they have values.
call setreg("0", "")
call setreg("1", "")
call setreg("-", "")
call setreg("a", "")
call setreg('"', "")

function! InspectRegisters()
    let l:r0 = getreg("0")
    let l:r1 = getreg("1")
    let l:rm = getreg("-")
    let l:ra = getreg("a")
    let l:rq = getreg('"')
    call setreg("0", "0:" . l:r0)
    :$put 0
    call setreg("1", "1:" . l:r1)
    :$put 1
    call setreg("-", "-:" . l:rm)
    :$put -
    call setreg("a", "a:" . l:ra)
    :$put a
    call setreg('"', '":' . l:rq)
    :$put "
endfunction

" Inspect the registers.
nnoremap X <Cmd>call InspectRegisters()<CR>
