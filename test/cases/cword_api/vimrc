execute "source " . expand("<sfile>:p:h:h") . "/vimrc"

function! s:insert_cword(word)
    execute "normal! i\<C-r>=jieba_vim#cword(" . a:word . ")\<CR>\<Esc>"
endfunction

function s:insert_ctoken(word)
    execute "normal! i\<C-r>=jieba_vim#ctoken(" . a:word . ")\<CR>\<Esc>"
endfunction

nnoremap x :call <SID>insert_cword(1)<CR>
nnoremap X :call <SID>insert_cword(0)<CR>
nnoremap y :call <SID>insert_ctoken(1)<CR>
nnoremap Y :call <SID>insert_ctoken(0)<CR>
