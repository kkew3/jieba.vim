// This file contains tests for the jieba_vim#cword() and jieba_vim#ctoken()
// APIs.
//
// Best viewed in Vim.

#V 5
#X i

#S0 iskeyword=a-z

// Cursor on word

B0 |abc,·def␊
K x
B1 ab|cabc,·def␊

B0 |abc,·def␊
K X
B1 abc|,abc,·def␊

B0 |abc,·def␊
K y
B1 ab|cabc,·def␊

B0 |abc,·def␊
K Y
B1 abc|,abc,·def␊

B0 ab|c,·def␊
K x
B1 abab|cc,·def␊

B0 ab|c,·def␊
K X
B1 ababc|,c,·def␊

B0 ab|c,·def␊
K y
B1 abab|cc,·def␊

B0 ab|c,·def␊
K Y
B1 ababc|,c,·def␊

// Cursor on space

B0 |···abc,·def␊
K x
B1 ab|c···abc,·def␊

B0 |···abc,·def␊
K X
B1 abc|,···abc,·def␊

B0 |···abc,·def␊
K y
B1 ··|····abc,·def␊

B0 |···abc,·def␊
K Y
B1 ··|····abc,·def␊

// Cursor on space, no further word

B0 |···,,,␊
K x
B1 ,,|,···,,,␊

B0 |···,,,␊
K X
B1 ,,|,···,,,␊

B0 |···,,,␊
K y
B1 ··|····,,,␊

B0 |···,,,␊
K Y
B1 ··|····,,,␊


// Cursor on space, no further word or WORD

B0 |···␊
K x
B1 |···␊

B0 |···␊
K X
B1 |···␊

B0 |···␊
K y
B1 ··|····␊

B0 |···␊
K Y
B1 ··|····␊

// Cursor on WORD

B0 |,,,abc␊
K x
B1 ab|c,,,abc␊

B0 |,,,abc␊
K X
B1 ,,,ab|c,,,abc␊

B0 |,,,abc␊
K y
B1 ,,|,,,,abc␊

B0 |,,,abc␊
K Y
B1 ,,,ab|c,,,abc␊

// Cursor on WORD, no further word

B0 |,,,···␊
K x
B1 ,,|,,,,···␊

B0 |,,,···␊
K X
B1 ,,|,,,,···␊

B0 |,,,···␊
K y
B1 ,,|,,,,···␊

B0 |,,,···␊
K Y
B1 ,,|,,,,···␊
