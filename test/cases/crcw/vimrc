execute "source " . expand("<sfile>:p:h:h") . "/vimrc"

cmap <C-r><C-w> <Plug>(Jieba_C_r_C_w)
cmap <C-r><C-a> <Plug>(Jieba_C_r_C_a)

" Test idea comes from chaoren/vim-wordmotion
" (https://github.com/chaoren/vim-wordmotion/blob/master/tests/crcw.vader).

function! s:replace_crcw()
    execute "normal :s/\<C-r>\<C-w>/X/\<CR>"
endfunction

function! s:replace_crca()
    execute "normal :s/\<C-r>\<C-a>/X/\<CR>"
endfunction

nnoremap x :call <SID>replace_crcw()<CR>
nnoremap X :call <SID>replace_crca()<CR>
