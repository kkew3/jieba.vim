// This file contains test cases that check for vim-surround |ys| behavior when
// working with dot-repeat |.| regarding word motions and text objects.
//
// Best viewed in Vim.

#V 5

#X i

// Basic word motions / text objects: w b e ge iw aw

B0 abc·|def·ghi·jkl␊
K yswb fg .
B1 abc·(def)·|(ghi)·jkl␊

B0 |abc·def·ghi·jkl␊
K yswb fd .
B1 (abc)·|(def)·ghi·jkl␊

B0 |abc·def·ghi·jkl␊
K yswb fd 2.
B1 (abc)·|(def·ghi)·jkl␊

B0 abc·def·ghi·jk|l␊
K ysbb .
B1 abc·def·|(ghi)·(jk)l␊

B0 abc·def·ghi·jk|l␊
K ysbb 2.
B1 abc·|(def·ghi)·(jk)l␊

B0 abc·def·ghi·jk|l␊
K ysbb . .
B1 abc·|(def)·(ghi)·(jk)l␊

B0 abc·|def·ghi·jkl␊
K yseb fg .
B1 abc·(def)·|(ghi)·jkl␊

B0 abc·def·ghi·jk|l␊
K ysgeb .
B1 abc·def·g|(h()i·jkl)␊

B0 abc·def·ghi·jk|l␊
K ysgeb Ffl .
B1 abc·de|(f)·gh(i·jkl)␊

B0 abc·def·ghi·jk|l␊
K ysgeb Ffl 2.
B1 ab|(c·def)·gh(i·jkl)␊

B0 abc·d|ef·ghi·jkl␊
K ysiwb .
B1 abc·|(()def)·ghi·jkl␊

B0 abc·d|ef·ghi·jkl␊
K ysiWb .
B1 abc·|((def))·ghi·jkl␊

B0 a|bc·def·ghi·jkl␊
K ys2awb fi .
B1 (abc·def)|(·ghi·jkl)␊

// Motion failure

B0 zzz␊|abc·defg·gh·ijkl␊
K gg0m<em> 2gg0 ys2aw) fj
B1 zzz␊(abc·defg)·gh·i|jkl␊
S1 '<=[0,1,1,0] '>=[0,1,3,0]

B0 zzz␊|abc·defg·gh·ijkl␊
K gg0m<em> 2gg0 ys2aw) fj .
B1 zzz␊(abc·defg)·gh·ijk|l␊
S1 '<=[0,1,1,0] '>=[0,1,3,0]
